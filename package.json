{
  "name": "kidz-universo",
  "private": true,
  "version": "0.1.0",
  "description": "Aplicación educativa para niños: explora el universo de forma visual y divertida",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
